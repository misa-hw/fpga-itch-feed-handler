# Timing-analysis wrapper only (src/hw/timing_top.ml); never loaded on the board.
# Clocked from the GMII receive clock pin (PHY RX_CLK, 125 MHz at 1 Gb/s);
# I/O placed on the GMII pins so that placement is realistic.
set_property -dict {PACKAGE_PIN P4 IOSTANDARD LVCMOS33} [get_ports clock]
create_clock -period 8.000 [get_ports clock]
set_property -dict {PACKAGE_PIN L3 IOSTANDARD LVCMOS33} [get_ports rx_valid]
set_property -dict {PACKAGE_PIN U5 IOSTANDARD LVCMOS33} [get_ports rx_err]
set_property -dict {PACKAGE_PIN U4 IOSTANDARD LVCMOS33} [get_ports rx_first]
set_property -dict {PACKAGE_PIN U2 IOSTANDARD LVCMOS33} [get_ports rx_last]
set_property -dict {PACKAGE_PIN M4 IOSTANDARD LVCMOS33} [get_ports {rx_data[0]}]
set_property -dict {PACKAGE_PIN N3 IOSTANDARD LVCMOS33} [get_ports {rx_data[1]}]
set_property -dict {PACKAGE_PIN N4 IOSTANDARD LVCMOS33} [get_ports {rx_data[2]}]
set_property -dict {PACKAGE_PIN P3 IOSTANDARD LVCMOS33} [get_ports {rx_data[3]}]
set_property -dict {PACKAGE_PIN R3 IOSTANDARD LVCMOS33} [get_ports {rx_data[4]}]
set_property -dict {PACKAGE_PIN T3 IOSTANDARD LVCMOS33} [get_ports {rx_data[5]}]
set_property -dict {PACKAGE_PIN T4 IOSTANDARD LVCMOS33} [get_ports {rx_data[6]}]
set_property -dict {PACKAGE_PIN T5 IOSTANDARD LVCMOS33} [get_ports {rx_data[7]}]
set_property -dict {PACKAGE_PIN R2 IOSTANDARD LVCMOS33} [get_ports {fold[0]}]
set_property -dict {PACKAGE_PIN P1 IOSTANDARD LVCMOS33} [get_ports {fold[1]}]
set_property -dict {PACKAGE_PIN N2 IOSTANDARD LVCMOS33} [get_ports {fold[2]}]
set_property -dict {PACKAGE_PIN N1 IOSTANDARD LVCMOS33} [get_ports {fold[3]}]
set_property -dict {PACKAGE_PIN M1 IOSTANDARD LVCMOS33} [get_ports {fold[4]}]
set_property -dict {PACKAGE_PIN L2 IOSTANDARD LVCMOS33} [get_ports {fold[5]}]
set_property -dict {PACKAGE_PIN K2 IOSTANDARD LVCMOS33} [get_ports {fold[6]}]
set_property -dict {PACKAGE_PIN K1 IOSTANDARD LVCMOS33} [get_ports {fold[7]}]
